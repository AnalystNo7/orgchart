generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScenarioStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ShetilType {
  REVENUE
  RESOURCE
  SERVICE
  BACKOFFICE
}

enum EmployeeCategory {
  PP
  OPP
  AUP
}

enum ContractType {
  REVENUE
  EXPENSE
}

enum ContractStatus {
  CONCLUDED
  PLANNED
}

enum RevenueProvisionStatus {
  PROVIDED
  PLANNED
  NOT_PROVIDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Scenario {
  id            String         @id @default(uuid())
  name          String
  description   String?
  isBaseline    Boolean        @default(false)
  status        ScenarioStatus @default(DRAFT)
  columnNames   Json?
  createdFromId String?
  createdFrom   Scenario?      @relation("ScenarioParent", fields: [createdFromId], references: [id])
  children      Scenario[]     @relation("ScenarioParent")
  departments   Department[]
  employees     Employee[]
  actionLogs    ActionLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Department {
  id         String     @id @default(uuid())
  scenarioId String
  scenario   Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children   Department[] @relation("DepartmentTree")
  name       String
  cfo        String?
  shetilType ShetilType
  headId     String?
  head       Employee?  @relation("DepartmentHead", fields: [headId], references: [id])
  sortOrder  Int        @default(0)
  employees  Employee[] @relation("DepartmentEmployees")
  originId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([scenarioId])
  @@index([parentId])
}

model ActionLog {
  id          String   @id @default(uuid())
  scenarioId  String?
  scenario    Scenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  actionType  String
  payload     Json
  undoPayload Json
  undone      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([scenarioId])
  @@index([scenarioId, createdAt])
}

model Employee {
  id           String           @id @default(uuid())
  scenarioId   String
  scenario     Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department       @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: Cascade)
  fullName     String
  position     String
  category     EmployeeCategory
  fte          Decimal          @default(1.0)
  costRate     Decimal?
  tariffId     String?
  tariff       Tariff?          @relation(fields: [tariffId], references: [id])
  headOf       Department[]     @relation("DepartmentHead")
  contracts    EmployeeContract[]
  originId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([scenarioId])
  @@index([departmentId])
}

model Tariff {
  id          String     @id @default(uuid())
  name        String     @unique
  rate        Decimal
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Contract {
  id             String         @id @default(uuid())
  name           String
  type           ContractType
  status         ContractStatus
  amount         Decimal?
  expectedAmount Decimal?
  periodStart    DateTime
  periodEnd      DateTime
  description    String?
  employees      EmployeeContract[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model EmployeeContract {
  id            String                 @id @default(uuid())
  employeeId    String
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId    String
  contract      Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  revenueStatus RevenueProvisionStatus
  fte           Decimal
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([employeeId, contractId])
  @@index([employeeId])
  @@index([contractId])
}

model PnlCache {
  id            String   @id @default(uuid())
  scenarioId    String
  departmentId  String
  mode          String   // "forecast" | "plan" | "combined"
  periodStart   DateTime
  periodEnd     DateTime
  revenue       Decimal  @default(0)
  cost          Decimal  @default(0)
  pnl           Decimal  @default(0)
  details       Json     // {employees: [...], contracts: [...]}
  warnings      Json?    // [{employeeId, message}]
  calculatedAt  DateTime @default(now())

  @@unique([scenarioId, departmentId, mode, periodStart, periodEnd])
  @@index([scenarioId])
  @@index([scenarioId, mode])
}
